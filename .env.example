# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=mausclaw
MAUSCLAW_BIND_ADDRESS=127.0.0.1
MAUSCLAW_HTTP_PORT=8080
# Leave empty to use http://localhost:${MAUSCLAW_HTTP_PORT:-8080}.
MAUSCLAW_PUBLIC_URL=
# Leave empty to inherit MAUSCLAW_PUBLIC_URL.
MAUSCLAW_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set MAUSCLAW_PUBLIC_URL to https:// followed by the same hostname.
# Requires MAUSCLAW_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
MAUSCLAW_HTTPS_HOST=
MAUSCLAW_BASE_IMAGE=ghcr.io/milind-soni/mausclaw:latest
MAUSCLAW_LOCAL_IMAGE=mausclaw-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
MAUSCLAW_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
MAUSCLAW_DATA_EXTERNAL=false
